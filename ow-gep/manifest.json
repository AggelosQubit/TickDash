{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "TickDash GEP",
    "author": "TickDash",
    "version": "0.2.0",
    "minimum-overwolf-version": "0.170.0",
    "description": "Subscribe GEP damage + push to TickDash",
    "icon": "icons/icon.png",
    "icon_gray": "icons/icon_gray.png",
    "launcher_icon": "icons/icon.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "start_window": "background",
    "externally_connectable": {
      "matches": ["http://localhost:*", "http://127.0.0.1:*"]
    },
    "windows": {
      "background": {
        "file": "windows/background/background.html",
        "background_optimization": true,
        "is_background_page": true
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [5426]
    },
    "game_events": [5426],
    "launch_events": [
      { "event": "LaunchWithOverwolf", "start_minimized": true },
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [5426] },
        "start_minimized": true
      }
    ],
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
